<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for a per-project LaunchAgent that keeps a brainiphy
  graph in sync via `cerebro sync`. Generated by `cerebro schedule` — do not
  edit by hand, edit the placeholders below and regenerate instead.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.graphify.sync.__PROJECT_SLUG__</string>

    <key>ProgramArguments</key>
    <array>
        <string>__CEREBRO_EXE__</string>
        <string>sync</string>
        <string>__PROJECT_PATH__</string>
    </array>

    <key>StartInterval</key>
    <integer>__INTERVAL_SECONDS__</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/sync.out.log</string>

    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/sync.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
