<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for a per-project LaunchAgent that keeps a brainiphy
  graph in sync via `brain sync`. Generated by `brain schedule` — do not
  edit by hand, edit the placeholders below and regenerate instead.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.graphify.sync.__PROJECT_SLUG__</string>

    <!--
      The full flag below is load-bearing, and cheaper than it looks. A plain
      `brain sync` rebuilds with `graphify update`, a local AST pass: it
      mirrors new documents into raw/ and never indexes them semantically, so
      an unattended brain made of documents (the normal kind) quietly stops
      being current while reporting success on every run. `graphify extract`
      is the only pass that reads documents, and it is gated by its own
      manifest and semantic cache: measured on a corpus with nothing changed
      it re-extracts nothing and finishes in about a second, and when
      something has changed it pays for that file alone.

      Note for anyone editing this comment: XML forbids a double hyphen inside
      a comment, so flags cannot be written out here. A plist that fails to
      parse is rejected by launchd with nothing in the log the user reads.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>__BRAIN_EXE__</string>
        <string>sync</string>
        <string>__PROJECT_PATH__</string>
        <string>--full</string>
    </array>

    <!--
      launchd hands a job a bare PATH (/usr/bin:/bin:/usr/sbin:/sbin), not the
      login shell's. Without this the scheduled sync cannot find `claude`, and
      a brain that indexes through the Claude Code subscription silently loses
      its LLM backend the moment it stops being run by hand.
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__PATH__</string>
    </dict>

    <key>StartInterval</key>
    <integer>__INTERVAL_SECONDS__</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/sync.out.log</string>

    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/sync.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
